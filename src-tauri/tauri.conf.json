{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "microchat",
  "version": "0.4.1",
  "identifier": "com.sheeshcord.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "μChat",
        "width": 360,
        "height": 540,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0b0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "microchat",
    "category": "SocialNetworking",
    "shortDescription": "Voz e compartilhamento de tela para amigos",
    "longDescription": "μChat: chamadas de voz e compartilhamento de tela em alta qualidade para grupos pequenos.",
    "copyright": "© 2026 microchat (MIT)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR", "English"],
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "μChat"
      }
    }
  }
}
