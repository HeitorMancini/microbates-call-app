# TLS automático (Let's Encrypt, HTTP-01): o DNS de {$DOMAIN} precisa apontar para esta VM
# e as portas 80/443 precisam estar abertas.
{$DOMAIN} {
	# token-server (só escuta em 127.0.0.1)
	handle /token {
		reverse_proxy 127.0.0.1:7890
	}
	handle /health {
		reverse_proxy 127.0.0.1:7890
	}

	# LiveKit: sinalização WebSocket (/rtc) e API
	handle {
		reverse_proxy 127.0.0.1:7880
	}
}
